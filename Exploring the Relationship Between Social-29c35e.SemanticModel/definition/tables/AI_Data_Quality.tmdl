		lineageTag: 8e9dbc35-e132-538f-a369-203f7e3827a1
		summarizeBy: none
		sourceColumn: [Action Taken]

	column Status
		dataType: boolean
		lineageTag: 2e28805a-a934-5d61-be9e-13e8af989dc7
		summarizeBy: none
